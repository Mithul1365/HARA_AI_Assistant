FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV HF_HOME=/app/model-cache
ENV OLLAMA_URL=http://host.docker.internal:11434/api/chat

WORKDIR /app

COPY requirements-docker.txt .
RUN python -m pip install --no-cache-dir --upgrade pip
RUN python -m pip install --no-cache-dir torch==2.6.0 --index-url https://download.pytorch.org/whl/cpu
RUN python -m pip install --no-cache-dir -r requirements-docker.txt --index-url https://pypi.org/simple

COPY api/api_server.py ./api/api_server.py
COPY backend/ ./backend/
COPY rag/ ./rag/
COPY data/knowledge_base/ ./data/knowledge_base/

RUN mkdir -p /app/data/documents /app/data/uploaded_index_cache

EXPOSE 8000

CMD ["uvicorn", "api.api_server:app", "--host", "0.0.0.0", "--port", "8000"]
