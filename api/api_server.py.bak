from pathlib import Path
from typing import Dict, Any, List, Optional
import hashlib
import pickle
import uuid

from fastapi import FastAPI, File, UploadFile, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel


# ============================================================
# PROJECT PATH
# ============================================================

BASE_DIR = Path(__file__).resolve().parents[1]

DATA_DIR = BASE_DIR / "data"
CACHE_DIR = DATA_DIR / "uploaded_index_cache"

CACHE_DIR.mkdir(parents=True, exist_ok=True)


# ============================================================
# EXISTING BACKEND IMPORTS
# ============================================================

from backend.document_processor import extract_text_from_pdf
from backend.llm_engine import analyze_with_qwen

from backend.asil_engine import (
    calculate_asil,
    get_asil_rationale,
)

from rag.chunker import create_chunks


# ============================================================
# LAZY RAG IMPORTS
# ============================================================
# SentenceTransformer / FAISS are heavy.
# Import them only when required.


def create_vector_store(*args, **kwargs):
    from rag.vector_store import (
        create_vector_store as _create_vector_store
    )

    return _create_vector_store(
        *args,
        **kwargs
    )


def search_documents(*args, **kwargs):
    from rag.vector_store import (
        search_documents as _search_documents
    )

    return _search_documents(
        *args,
        **kwargs
    )


# ============================================================
# FASTAPI APP
# ============================================================

app = FastAPI(
    title="HARA AI Assistant API",
    description=(
        "API bridge for HARA AI Assistant frontend. "
        "Uses the existing Python backend, RAG and local Qwen3."
    ),
    version="1.0.0",
)


# ============================================================
# CORS
# ============================================================
# Allows the Vite frontend to communicate with FastAPI.


app.add_middleware(
    CORSMiddleware,
    allow_origins=[
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "http://localhost:3000",
        "http://127.0.0.1:3000",
    ],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


# ============================================================
# IN-MEMORY DOCUMENT STORE
# ============================================================
# Keeps uploaded document information available while
# FastAPI is running.
#
# Structure:
#
# DOCUMENTS[document_id] = {
#     "document_name": ...,
#     "pdf_hash": ...,
#     "pages": ...,
#     "chunks": ...,
#     "vector_index": ...
# }


DOCUMENTS: Dict[str, Dict[str, Any]] = {}


# ============================================================
# REQUEST MODELS
# ============================================================


class HaraAnalyzeRequest(BaseModel):
    document_id: str

    system: str
    function: str
    scenario: str

    operating_conditions: Optional[str] = ""


class AsilCalculateRequest(BaseModel):
    severity: str
    exposure: str
    controllability: str


# ============================================================
# HEALTH CHECK
# ============================================================


@app.get("/api/health")
def health_check():
    return {
        "status": "ok",
        "service": "HARA AI Assistant API",
        "backend": "connected",
    }


# ============================================================
# ROOT
# ============================================================


@app.get("/")
def root():
    return {
        "service": "HARA AI Assistant API",
        "status": "running",
        "docs": "/docs",
    }


# ============================================================
# DOCUMENT UPLOAD
# ============================================================


@app.post("/api/documents/upload")
async def upload_document(
    file: UploadFile = File(...)
):
    """
    Upload engineering PDF.

    Flow:

        PDF
          ↓
        Text Extraction
          ↓
        Chunking
          ↓
        FAISS Vector Index
          ↓
        In-memory document store
          ↓
        HARA Analysis
    """

    # --------------------------------------------------------
    # Validate file
    # --------------------------------------------------------

    if not file.filename:
        raise HTTPException(
            status_code=400,
            detail="No file selected.",
        )

    filename = file.filename

    if not filename.lower().endswith(".pdf"):
        raise HTTPException(
            status_code=400,
            detail="Only PDF files are supported.",
        )

    try:

        # ----------------------------------------------------
        # Read PDF bytes
        # ----------------------------------------------------

        pdf_bytes = await file.read()

        if not pdf_bytes:
            raise HTTPException(
                status_code=400,
                detail="Uploaded PDF is empty.",
            )

        # ----------------------------------------------------
        # PDF hash
        # ----------------------------------------------------

        pdf_hash = hashlib.sha256(
            pdf_bytes
        ).hexdigest()[:16]

        # ----------------------------------------------------
        # Extract PDF text
        # ----------------------------------------------------
        #
        # Existing document_processor expects a file-like
        # object. BytesIO gives it the same interface.
        # ----------------------------------------------------

        from io import BytesIO

        pdf_file = BytesIO(pdf_bytes)

        pages = extract_text_from_pdf(
            pdf_file
        )

        if not pages:
            raise HTTPException(
                status_code=400,
                detail=(
                    "No readable text was found "
                    "in the uploaded PDF."
                ),
            )

        # ----------------------------------------------------
        # Create chunks using EXISTING chunker
        # ----------------------------------------------------

        chunks = create_chunks(
            pages
        )

        if not chunks:
            raise HTTPException(
                status_code=400,
                detail=(
                    "PDF was extracted successfully, "
                    "but no document chunks were created."
                ),
            )

        # ----------------------------------------------------
        # Add source/category metadata
        # ----------------------------------------------------

        for chunk in chunks:

            chunk["source"] = filename

            chunk["category"] = (
                "uploaded_document"
            )

        # ----------------------------------------------------
        # Document ID
        # ----------------------------------------------------

        document_id = str(
            uuid.uuid4()
        )

        # ----------------------------------------------------
        # FAISS CACHE PATH
        # ----------------------------------------------------

        cache_path = (
            CACHE_DIR
            / f"{pdf_hash}.pkl"
        )

        vector_index = None
        vector_index_cached = False
        vector_index_created = False

        # ----------------------------------------------------
        # LOAD EXISTING FAISS INDEX
        # ----------------------------------------------------

        if cache_path.exists():

            try:

                with open(
                    cache_path,
                    "rb"
                ) as cache_file:

                    cached_data = pickle.load(
                        cache_file
                    )

                cached_index = (
                    cached_data.get("index")
                )

                cached_document_name = (
                    cached_data.get(
                        "document_name",
                        filename
                    )
                )

                cached_pdf_hash = (
                    cached_data.get(
                        "pdf_hash",
                        pdf_hash
                    )
                )

                # Make sure cache belongs to same PDF
                if (
                    cached_pdf_hash
                    == pdf_hash
                    and cached_index is not None
                ):

                    vector_index = cached_index

                    vector_index_cached = True

            except Exception as exc:

                print(
                    "[RAG] Cached FAISS index "
                    f"could not be loaded: {exc}"
                )

                vector_index = None

        # ----------------------------------------------------
        # CREATE FAISS INDEX IF CACHE NOT AVAILABLE
        # ----------------------------------------------------

        if vector_index is None:

            try:

                print(
                    "[RAG] Creating FAISS "
                    "vector index..."
                )

                vector_index = create_vector_store(
                    chunks
                )

                if vector_index is not None:

                    vector_index_created = True

                    # Save cache
                    with open(
                        cache_path,
                        "wb"
                    ) as cache_file:

                        pickle.dump(
                            {
                                "index": vector_index,
                                "document_name": filename,
                                "pdf_hash": pdf_hash,
                            },
                            cache_file,
                        )

                    print(
                        "[RAG] FAISS vector index "
                        "created and cached."
                    )

            except Exception as exc:

                print(
                    "[RAG] Vector index creation "
                    f"failed: {exc}"
                )

                vector_index = None

        # ----------------------------------------------------
        # SAVE DOCUMENT IN MEMORY
        # ----------------------------------------------------

        DOCUMENTS[document_id] = {
            "document_id": document_id,
            "document_name": filename,
            "pdf_hash": pdf_hash,
            "pages": pages,
            "chunks": chunks,
            "vector_index": vector_index,
        }

        # ----------------------------------------------------
        # RESPONSE
        # ----------------------------------------------------

        return {
            "success": True,
            "document_id": document_id,
            "document_name": filename,
            "pdf_hash": pdf_hash,
            "pages": len(pages),
            "chunks": len(chunks),
            "vector_index_cached": vector_index_cached,
            "vector_index_created": vector_index_created,
            "message": (
                "Engineering PDF extracted, "
                "chunked, and indexed successfully."
            ),
        }

    except HTTPException:
        raise

    except Exception as exc:

        print(
            "[UPLOAD ERROR]",
            repr(exc)
        )

        raise HTTPException(
            status_code=500,
            detail=(
                "Document processing failed: "
                f"{str(exc)}"
            ),
        )


# ============================================================
# DOCUMENT INFO
# ============================================================


@app.get("/api/documents/{document_id}")
def get_document(
    document_id: str
):

    document = DOCUMENTS.get(
        document_id
    )

    if document is None:

        raise HTTPException(
            status_code=404,
            detail="Document not found.",
        )

    return {
        "success": True,
        "document_id": document_id,
        "document_name": document[
            "document_name"
        ],
        "pdf_hash": document[
            "pdf_hash"
        ],
        "pages": len(
            document["pages"]
        ),
        "chunks": len(
            document["chunks"]
        ),
        "vector_index_available": (
            document["vector_index"]
            is not None
        ),
    }


# ============================================================
# HARA ANALYSIS
# ============================================================


@app.post("/api/hara/analyze")
def hara_analysis(
    request: HaraAnalyzeRequest
):
    """
    Existing HARA flow:

        Uploaded PDF
              ↓
        Existing chunks
              ↓
        Existing FAISS retrieval
              ↓
        Engineering evidence
              ↓
        Existing Qwen3 engine
              ↓
        3 HARA candidates
    """

    # --------------------------------------------------------
    # Get document
    # --------------------------------------------------------

    document = DOCUMENTS.get(
        request.document_id
    )

    if document is None:

        raise HTTPException(
            status_code=404,
            detail=(
                "Document not found. "
                "Please upload the engineering PDF again."
            ),
        )

    # --------------------------------------------------------
    # Validate Item Definition
    # --------------------------------------------------------

    if not request.system.strip():

        raise HTTPException(
            status_code=400,
            detail="System / Item is required.",
        )

    if not request.function.strip():

        raise HTTPException(
            status_code=400,
            detail="Intended Function is required.",
        )

    if not request.scenario.strip():

        raise HTTPException(
            status_code=400,
            detail=(
                "Operational Scenario is required."
            ),
        )

    # --------------------------------------------------------
    # Build retrieval query
    # --------------------------------------------------------

    query = f"""
System / Item:
{request.system}

Intended Function:
{request.function}

Operational Scenario:
{request.scenario}

Operating Conditions:
{request.operating_conditions or "Not specified"}

Identify relevant engineering evidence for this
automotive function, its malfunctions, hazards and
hazardous events.
""".strip()

    chunks = document[
        "chunks"
    ]

    vector_index = document[
        "vector_index"
    ]

    evidence_results: List[
        Dict[str, Any]
    ] = []

    # --------------------------------------------------------
    # PRIMARY SOURCE:
    # UPLOADED ENGINEERING DOCUMENT
    # --------------------------------------------------------

    if (
        vector_index is not None
        and chunks
    ):

        try:

            evidence_results = search_documents(
                query=query,
                chunks=chunks,
                index=vector_index,
                top_k=5,
                min_relevance=0.20,
            )

        except Exception as exc:

            print(
                "[RAG] Document search failed:",
                repr(exc)
            )

            evidence_results = []

    # --------------------------------------------------------
    # SAFE FALLBACK
    # --------------------------------------------------------
    #
    # If the PDF does not contain a sufficiently matching
    # section, continue using engineer-provided context.
    #
    # This is explicitly labelled as user context,
    # NOT as extracted PDF evidence.
    # --------------------------------------------------------

    evidence_mode = (
        "Uploaded Engineering Document"
    )

    if not evidence_results:

        fallback_text = (
            f"System / Item: {request.system}. "
            f"Intended Function: {request.function}. "
            f"Operational Scenario: {request.scenario}. "
            f"Operating Conditions: "
            f"{request.operating_conditions or 'Not specified'}. "
            "This context was provided directly by "
            "the engineer for HARA candidate generation. "
            "No sufficiently relevant matching section "
            "was found in the uploaded document."
        )

        evidence_results = [
            {
                "source": (
                    "User-Provided Item Definition"
                ),
                "page": "-",
                "text": fallback_text,
                "score": 1.0,
                "evidence_type": "user_context",
            }
        ]

        evidence_mode = (
            "User-Provided Item Definition"
        )

    # --------------------------------------------------------
    # Prepare evidence for existing Qwen engine
    # --------------------------------------------------------

    evidence = []

    for result in evidence_results:

        evidence.append(
            {
                "source": result.get(
                    "source",
                    "Engineering Document"
                ),
                "page": result.get(
                    "page",
                    "?"
                ),
                "text": str(
                    result.get(
                        "text",
                        ""
                    )
                ),
            }
        )

    # --------------------------------------------------------
    # EXISTING QWEN3 ENGINE
    # --------------------------------------------------------

    try:

        hara_result = analyze_with_qwen(
            system=request.system,
            function=request.function,
            scenario=request.scenario,
            evidence=evidence,
        )

    except Exception as exc:

        print(
            "[Qwen] HARA analysis failed:",
            repr(exc)
        )

        raise HTTPException(
            status_code=500,
            detail=(
                "Qwen3 HARA analysis failed: "
                f"{str(exc)}"
            ),
        )

    # --------------------------------------------------------
    # Response
    # --------------------------------------------------------

    return {
        "success": True,

        "document_id": (
            request.document_id
        ),

        "document_name": document[
            "document_name"
        ],

        "system": request.system,

        "function": request.function,

        "scenario": request.scenario,

        "operating_conditions": (
            request.operating_conditions
        ),

        "evidence_mode": evidence_mode,

        "evidence": evidence_results,

        "hara_result": hara_result,

        "message": (
            "HARA analysis completed using "
            "uploaded engineering evidence "
            "and local Qwen3."
        ),
    }


# ============================================================
# ASIL CALCULATION
# ============================================================


@app.post("/api/asil/calculate")
def calculate_asil_api(
    request: AsilCalculateRequest
):
    """
    Candidate ASIL calculation.

    Uses the EXISTING backend ASIL engine.

    Inputs:
        Severity       S0-S3
        Exposure       E0-E4
        Controllability C0-C3

    Output:
        Candidate ASIL
        Engineering rationale
    """

    # --------------------------------------------------------
    # Normalize input
    # --------------------------------------------------------

    severity = (
        request.severity
        .strip()
        .upper()
    )

    exposure = (
        request.exposure
        .strip()
        .upper()
    )

    controllability = (
        request.controllability
        .strip()
        .upper()
    )

    # --------------------------------------------------------
    # Validate
    # --------------------------------------------------------

    valid_severity = {
        "S0",
        "S1",
        "S2",
        "S3",
    }

    valid_exposure = {
        "E0",
        "E1",
        "E2",
        "E3",
        "E4",
    }

    valid_controllability = {
        "C0",
        "C1",
        "C2",
        "C3",
    }

    if severity not in valid_severity:

        raise HTTPException(
            status_code=400,
            detail=(
                "Invalid Severity. "
                "Use S0, S1, S2 or S3."
            ),
        )

    if exposure not in valid_exposure:

        raise HTTPException(
            status_code=400,
            detail=(
                "Invalid Exposure. "
                "Use E0, E1, E2, E3 or E4."
            ),
        )

    if (
        controllability
        not in valid_controllability
    ):

        raise HTTPException(
            status_code=400,
            detail=(
                "Invalid Controllability. "
                "Use C0, C1, C2 or C3."
            ),
        )

    # --------------------------------------------------------
    # EXISTING ASIL ENGINE
    # --------------------------------------------------------

    try:

        candidate_asil = calculate_asil(
            severity=severity,
            exposure=exposure,
            controllability=controllability,
        )

        asil_rationale = get_asil_rationale(
            severity=severity,
            exposure=exposure,
            controllability=controllability,
            asil=candidate_asil,
        )

    except Exception as exc:

        print(
            "[ASIL] Calculation failed:",
            repr(exc)
        )

        raise HTTPException(
            status_code=500,
            detail=(
                "ASIL calculation failed: "
                f"{str(exc)}"
            ),
        )

    # --------------------------------------------------------
    # Response
    # --------------------------------------------------------

    return {
        "success": True,

        "severity": severity,

        "exposure": exposure,

        "controllability": controllability,

        "candidate_asil": candidate_asil,

        "asil_rationale": asil_rationale,

        "review_required": True,

        "message": (
            "Candidate ASIL calculated using "
            "the existing ASIL engine."
        ),
    }


# ============================================================
# DOCUMENT CACHE / DEBUG INFO
# ============================================================


@app.get("/api/documents")
def list_documents():

    documents = []

    for document_id, document in (
        DOCUMENTS.items()
    ):

        documents.append(
            {
                "document_id": document_id,
                "document_name": document[
                    "document_name"
                ],
                "pdf_hash": document[
                    "pdf_hash"
                ],
                "pages": len(
                    document["pages"]
                ),
                "chunks": len(
                    document["chunks"]
                ),
                "vector_index_available": (
                    document[
                        "vector_index"
                    ]
                    is not None
                ),
            }
        )

    return {
        "success": True,
        "count": len(documents),
        "documents": documents,
    }


