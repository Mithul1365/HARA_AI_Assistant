import { useEffect, useState } from 'react';

import type {
  DocumentData,
  ItemContext,
  HaraScenario,
} from '@/App';


interface AsilAssessmentProps {

  documentData:
    DocumentData | null;

  itemContext:
    ItemContext;

  scenarios:
    HaraScenario[];

  selectedScenario:
    HaraScenario | null;

  onPrevious:
    () => void;

  onContinue:
    () => void;
}


interface AsilResult {

  asil: string;

  rationale: string;

}


function AsilAssessment({
  documentData,
  itemContext,
  scenarios,
  selectedScenario,
  onPrevious,
  onContinue,
}: AsilAssessmentProps) {

  const [currentScenario, setCurrentScenario] =
    useState<HaraScenario | null>(
      selectedScenario ||
      scenarios[0] ||
      null
    );


  const [severity, setSeverity] =
    useState('');

  const [exposure, setExposure] =
    useState('');

  const [controllability, setControllability] =
    useState('');


  const [result, setResult] =
    useState<AsilResult | null>(null);


  const [loading, setLoading] =
    useState(false);


  const [error, setError] =
    useState('');


  useEffect(() => {

    setCurrentScenario(
      selectedScenario ||
      scenarios[0] ||
      null
    );

  }, [
    selectedScenario,
    scenarios,
  ]);


  const calculateAsil = async () => {

    if (
      !severity ||
      !exposure ||
      !controllability
    ) {

      setError(
        'Please select Severity, Exposure and Controllability.'
      );

      return;
    }


    setLoading(true);

    setError('');

    setResult(null);


    try {

      const response =
        await fetch(
          'http://127.0.0.1:8000/api/asil/calculate',
          {
            method: 'POST',

            headers: {
              'Content-Type':
                'application/json',
            },

            body: JSON.stringify({

              severity,

              exposure,

              controllability,

            }),
          }
        );


      if (!response.ok) {

        throw new Error(
          `ASIL API request failed with status ${response.status}`
        );

      }


      const data =
        await response.json();


      if (!data.success) {

        throw new Error(
          data.message ||
          'ASIL calculation failed.'
        );

      }


      setResult({

        asil:
          data.asil,

        rationale:
          data.rationale,

      });

    }

    catch (err) {

      setError(

        err instanceof Error
          ? err.message
          : 'Unable to calculate ASIL.'

      );

    }

    finally {

      setLoading(false);

    }

  };


  return (

    <div className="min-h-full bg-slate-50 p-6">

      {/* =================================================
          PAGE HEADER
          ================================================= */}

      <div className="mb-6">

        <h1 className="text-2xl font-bold text-slate-900">
          ASIL Assessment
        </h1>

        <p className="mt-1 text-sm text-slate-500">
          Severity, Exposure and Controllability assessment
        </p>

      </div>


      {/* =================================================
          DOCUMENT / ITEM CONTEXT
          ================================================= */}

      <div className="mb-6 grid grid-cols-1 gap-4 lg:grid-cols-3">

        <div className="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">

          <div className="text-xs font-semibold uppercase tracking-wide text-slate-500">
            Engineering Document
          </div>

          <div className="mt-2 text-sm font-medium text-slate-900">
            {
              documentData?.documentName ||
              'Not available'
            }
          </div>

        </div>


        <div className="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">

          <div className="text-xs font-semibold uppercase tracking-wide text-slate-500">
            System / Item
          </div>

          <div className="mt-2 text-sm font-medium text-slate-900">
            {
              itemContext.systemItem ||
              'Not available'
            }
          </div>

        </div>


        <div className="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">

          <div className="text-xs font-semibold uppercase tracking-wide text-slate-500">
            Operational Scenario
          </div>

          <div className="mt-2 text-sm text-slate-700">
            {
              itemContext.operationalScenario ||
              'Not available'
            }
          </div>

        </div>

      </div>


      {/* =================================================
          HARA CANDIDATE
          ================================================= */}

      <div className="mb-6 rounded-xl border border-blue-200 bg-blue-50 p-5">

        <div className="mb-4 flex items-center justify-between">

          <div>

            <h2 className="font-bold text-blue-900">
              Selected HARA Candidate
            </h2>

            <p className="mt-1 text-xs text-blue-700">
              The S/E/C assessment is performed for this hazardous event.
            </p>

          </div>

          <div className="rounded-full bg-blue-700 px-3 py-1 text-xs font-semibold text-white">
            HARA
          </div>

        </div>


        {currentScenario ? (

          <div className="grid grid-cols-1 gap-4 md:grid-cols-3">

            <div className="rounded-lg bg-white p-4">

              <div className="text-xs font-semibold uppercase text-slate-500">
                Potential Malfunction
              </div>

              <p className="mt-2 text-sm text-slate-800">
                {
                  currentScenario.malfunction
                }
              </p>

            </div>


            <div className="rounded-lg bg-white p-4">

              <div className="text-xs font-semibold uppercase text-slate-500">
                Potential Hazard
              </div>

              <p className="mt-2 text-sm text-slate-800">
                {
                  currentScenario.hazard
                }
              </p>

            </div>


            <div className="rounded-lg bg-white p-4">

              <div className="text-xs font-semibold uppercase text-slate-500">
                Hazardous Event
              </div>

              <p className="mt-2 text-sm text-slate-800">
                {
                  currentScenario.event
                }
              </p>

            </div>

          </div>

        ) : (

          <div className="rounded-lg bg-white p-4 text-sm text-slate-500">
            No HARA candidate was selected.
          </div>

        )}

      </div>


      {/* =================================================
          S / E / C
          ================================================= */}

      <div className="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">

        <div className="mb-6">

          <h2 className="text-lg font-bold text-slate-900">
            S / E / C Assessment
          </h2>

          <p className="mt-1 text-sm text-slate-500">
            Select Severity, Exposure and Controllability for the selected hazardous event.
          </p>

        </div>


        <div className="grid grid-cols-1 gap-5 md:grid-cols-3">

          {/* Severity */}

          <div>

            <label className="mb-2 block text-sm font-semibold text-slate-700">
              Severity (S)
            </label>

            <select
              value={severity}
              onChange={(e) =>
                setSeverity(
                  e.target.value
                )
              }
              className="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100"
            >

              <option value="">
                Select Severity
              </option>

              <option value="S0">
                S0 — No injuries
              </option>

              <option value="S1">
                S1 — Light to moderate injuries
              </option>

              <option value="S2">
                S2 — Severe injuries
              </option>

              <option value="S3">
                S3 — Life-threatening / fatal injuries
              </option>

            </select>

          </div>


          {/* Exposure */}

          <div>

            <label className="mb-2 block text-sm font-semibold text-slate-700">
              Exposure (E)
            </label>

            <select
              value={exposure}
              onChange={(e) =>
                setExposure(
                  e.target.value
                )
              }
              className="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100"
            >

              <option value="">
                Select Exposure
              </option>

              <option value="E0">
                E0 — Incredible
              </option>

              <option value="E1">
                E1 — Very low
              </option>

              <option value="E2">
                E2 — Low
              </option>

              <option value="E3">
                E3 — Medium
              </option>

              <option value="E4">
                E4 — High
              </option>

            </select>

          </div>


          {/* Controllability */}

          <div>

            <label className="mb-2 block text-sm font-semibold text-slate-700">
              Controllability (C)
            </label>

            <select
              value={controllability}
              onChange={(e) =>
                setControllability(
                  e.target.value
                )
              }
              className="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100"
            >

              <option value="">
                Select Controllability
              </option>

              <option value="C0">
                C0 — Fully controllable
              </option>

              <option value="C1">
                C1 — Generally controllable
              </option>

              <option value="C2">
                C2 — Normally controllable
              </option>

              <option value="C3">
                C3 — Difficult to control
              </option>

            </select>

          </div>

        </div>


        <div className="mt-5 rounded-lg bg-slate-50 p-4 text-xs text-slate-600">

          S/E/C values are engineering inputs.
          Candidate ASIL is decision-support output and
          requires functional-safety engineer review.

        </div>


        {/* Error */}

        {error && (

          <div className="mt-5 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">

            {error}

          </div>

        )}


        {/* Calculate */}

        <div className="mt-6">

          <button
            type="button"
            onClick={
              calculateAsil
            }
            disabled={
              loading ||
              !severity ||
              !exposure ||
              !controllability
            }
            className="rounded-lg bg-blue-700 px-6 py-3 text-sm font-semibold text-white transition hover:bg-blue-800 disabled:cursor-not-allowed disabled:opacity-50"
          >

            {loading
              ? 'Calculating ASIL...'
              : 'Calculate Candidate ASIL'}

          </button>

        </div>

      </div>


      {/* =================================================
          RESULT
          ================================================= */}

      {result && (

        <div className="mt-6 rounded-xl border border-green-200 bg-white p-6 shadow-sm">

          <div className="grid grid-cols-1 gap-6 md:grid-cols-[220px_1fr]">

            <div className="rounded-xl bg-green-50 p-6 text-center">

              <div className="text-xs font-semibold uppercase tracking-wide text-green-700">
                Candidate ASIL
              </div>

              <div className="mt-3 text-6xl font-black text-green-700">
                {result.asil}
              </div>

              <div className="mt-3 text-xs text-green-700">
                {severity} · {exposure} · {controllability}
              </div>

            </div>


            <div>

              <h2 className="text-lg font-bold text-slate-900">
                ASIL Assessment Result
              </h2>

              <div className="mt-4 space-y-3">

                <div>
                  <span className="font-semibold text-slate-700">
                    Severity:
                  </span>{' '}
                  {severity}
                </div>

                <div>
                  <span className="font-semibold text-slate-700">
                    Exposure:
                  </span>{' '}
                  {exposure}
                </div>

                <div>
                  <span className="font-semibold text-slate-700">
                    Controllability:
                  </span>{' '}
                  {controllability}
                </div>

              </div>


              <div className="mt-5 rounded-lg bg-slate-50 p-4">

                <div className="text-xs font-semibold uppercase tracking-wide text-slate-500">
                  Engineering Rationale
                </div>

                <p className="mt-2 text-sm leading-6 text-slate-700">
                  {result.rationale}
                </p>

              </div>


              <div className="mt-5 rounded-lg border border-amber-200 bg-amber-50 p-4 text-xs leading-5 text-amber-800">

                Candidate ASIL is decision-support output only.
                Final classification must be reviewed and approved
                by an authorized functional-safety engineer.

              </div>

            </div>

          </div>

        </div>

      )}


      {/* =================================================
          NAVIGATION
          ================================================= */}

      <div className="mt-8 flex items-center justify-between border-t border-slate-200 pt-5">

        <button
          type="button"
          onClick={
            onPrevious
          }
          className="rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
        >
          ← Previous
        </button>


        <button
          type="button"
          onClick={
            onContinue
          }
          disabled={
            !result
          }
          className="rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-800 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Continue to Safety Goals →
        </button>

      </div>

    </div>

  );

}


export default AsilAssessment;