import { useEffect, useState } from "react";

interface AsilResult {
  asil: string;
  rationale?: string;
  severity: string;
  exposure: string;
  controllability: string;
}

interface AsilAssessmentProps {
  onPrevious: () => void;
  onContinue: (result: AsilResult) => void;
  onResult?: (result: AsilResult) => void;
}

const severityOptions = ["S0", "S1", "S2", "S3"];
const exposureOptions = ["E0", "E1", "E2", "E3", "E4"];
const controllabilityOptions = ["C0", "C1", "C2", "C3"];

const HARA_ASIL_STORAGE_KEY = "hara_ai_assistant_asil_state";

export default function AsilAssessment({
  onPrevious,
  onContinue,
  onResult,
}: AsilAssessmentProps) {
  const [severity, setSeverity] = useState(() => {
    try {
      const saved = JSON.parse(
        localStorage.getItem(HARA_ASIL_STORAGE_KEY) || "null"
      );
      return saved?.severity || "";
    } catch {
      return "";
    }
  });
  const [exposure, setExposure] = useState(() => {
    try {
      const saved = JSON.parse(
        localStorage.getItem(HARA_ASIL_STORAGE_KEY) || "null"
      );
      return saved?.exposure || "";
    } catch {
      return "";
    }
  });
  const [controllability, setControllability] = useState(() => {
    try {
      const saved = JSON.parse(
        localStorage.getItem(HARA_ASIL_STORAGE_KEY) || "null"
      );
      return saved?.controllability || "";
    } catch {
      return "";
    }
  });

  const [result, setResult] = useState<AsilResult | null>(() => {
    try {
      const saved = JSON.parse(
        localStorage.getItem(HARA_ASIL_STORAGE_KEY) || "null"
      );
      return saved?.result || null;
    } catch {
      return null;
    }
  });

  useEffect(() => {
    try {
      localStorage.setItem(
        HARA_ASIL_STORAGE_KEY,
        JSON.stringify({
          severity,
          exposure,
          controllability,
          result,
        })
      );
    } catch {
      // Ignore localStorage errors.
    }
  }, [severity, exposure, controllability, result]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  useEffect(() => {
    if (!severity || !exposure || !controllability) {
      setResult(null);
      return;
    }

    let cancelled = false;

    const calculateAsil = async () => {
      setLoading(true);
      setError("");

      try {
        const response = await fetch(
          "http://127.0.0.1:8000/api/asil/calculate",
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              severity,
              exposure,
              controllability,
            }),
          }
        );

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.detail || "ASIL calculation failed");
        }

        if (cancelled) return;

        const calculatedResult: AsilResult = {
          asil: data.candidate_asil,
          rationale: data.rationale || "",
          severity,
          exposure,
          controllability,
        };

        setResult(calculatedResult);
        onResult?.(calculatedResult);
      } catch (err) {
        if (cancelled) return;

        setResult(null);
        setError(
          err instanceof Error
            ? err.message
            : "Unable to calculate ASIL."
        );
      } finally {
        if (!cancelled) {
          setLoading(false);
        }
      }
    };

    calculateAsil();

    return () => {
      cancelled = true;
    };
  }, [severity, exposure, controllability, onResult]);

  const canContinue = Boolean(result && !loading);

  return (
    <div className="space-y-6">
      <div>
        <h1 className="text-2xl font-semibold text-slate-900">
          ASIL Assessment
        </h1>

        <p className="mt-1 text-sm text-slate-500">
          Determine the candidate Automotive Safety Integrity Level using
          Severity, Exposure and Controllability.
        </p>
      </div>

      <div className="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <div className="mb-6">
          <h2 className="text-lg font-semibold text-slate-900">
            Risk Classification Inputs
          </h2>

          <p className="mt-1 text-sm text-slate-500">
            Select all three values. The candidate ASIL is calculated
            automatically.
          </p>
        </div>

        <div className="grid grid-cols-1 gap-5 md:grid-cols-3">
          <div>
            <label className="mb-2 block text-sm font-medium text-slate-700">
              Severity
            </label>

            <select
              value={severity}
              onChange={(e) => setSeverity(e.target.value)}
              className="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100"
            >
              <option value="">Select Severity</option>

              {severityOptions.map((value) => (
                <option key={value} value={value}>
                  {value}
                </option>
              ))}
            </select>
          </div>

          <div>
            <label className="mb-2 block text-sm font-medium text-slate-700">
              Exposure
            </label>

            <select
              value={exposure}
              onChange={(e) => setExposure(e.target.value)}
              className="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100"
            >
              <option value="">Select Exposure</option>

              {exposureOptions.map((value) => (
                <option key={value} value={value}>
                  {value}
                </option>
              ))}
            </select>
          </div>

          <div>
            <label className="mb-2 block text-sm font-medium text-slate-700">
              Controllability
            </label>

            <select
              value={controllability}
              onChange={(e) => setControllability(e.target.value)}
              className="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-900 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100"
            >
              <option value="">Select Controllability</option>

              {controllabilityOptions.map((value) => (
                <option key={value} value={value}>
                  {value}
                </option>
              ))}
            </select>
          </div>
        </div>

        {loading && (
          <div className="mt-5 rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-700">
            Calculating candidate ASIL...
          </div>
        )}

        {error && (
          <div className="mt-5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            {error}
          </div>
        )}
      </div>

      {result && (
        <div className="rounded-xl border border-blue-200 bg-white p-6 shadow-sm">
          <div className="flex items-center justify-between">
            <div>
              <h2 className="text-lg font-semibold text-slate-900">
                Candidate ASIL
              </h2>

              <p className="mt-1 text-sm text-slate-500">
                Calculated from the selected S, E and C values.
              </p>
            </div>

            <div className="flex h-16 w-20 items-center justify-center rounded-xl bg-blue-50 text-2xl font-bold text-blue-700">
              {result.asil}
            </div>
          </div>

          <div className="mt-5 grid grid-cols-3 gap-4">
            <div className="rounded-lg bg-slate-50 p-4">
              <div className="text-xs font-medium uppercase text-slate-500">
                Severity
              </div>
              <div className="mt-1 text-lg font-semibold text-slate-900">
                {result.severity}
              </div>
            </div>

            <div className="rounded-lg bg-slate-50 p-4">
              <div className="text-xs font-medium uppercase text-slate-500">
                Exposure
              </div>
              <div className="mt-1 text-lg font-semibold text-slate-900">
                {result.exposure}
              </div>
            </div>

            <div className="rounded-lg bg-slate-50 p-4">
              <div className="text-xs font-medium uppercase text-slate-500">
                Controllability
              </div>
              <div className="mt-1 text-lg font-semibold text-slate-900">
                {result.controllability}
              </div>
            </div>
          </div>

          {result.rationale && (
            <div className="mt-5 rounded-lg border border-slate-200 bg-slate-50 p-4">
              <div className="text-sm font-semibold text-slate-800">
                Rationale
              </div>

              <p className="mt-2 text-sm leading-6 text-slate-600">
                {result.rationale}
              </p>
            </div>
          )}

          <div className="mt-5 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
            Candidate ASIL is an AI-assisted engineering result and requires
            functional-safety engineer review.
          </div>
        </div>
      )}

      <div className="flex items-center justify-between border-t border-slate-200 pt-5">
        <button
          type="button"
          onClick={onPrevious}
          className="rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50"
        >
          Previous
        </button>

        <button
          type="button"
          onClick={() => result && onContinue(result)}
          disabled={!canContinue}
          className="rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Continue to Safety Goals
        </button>
      </div>
    </div>
  );
}





